# Все значения ниже — фиктивные примеры. Реальные секреты не коммитить.
# Режим по умолчанию — demo: работает без каких-либо ключей.

# demo | connected
APP_DATA_MODE=demo
# fixtures | football-data  (demo допускает только fixtures)
SPORTS_PROVIDER=fixtures

# --- Нужны только для APP_DATA_MODE=connected ---
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
# Только на сервере. Никогда не добавлять префикс NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Отдельный секрет для cron, не service-role. Минимум 32 символа.
CRON_SECRET=replace-me-with-a-random-string-of-32-chars-or-more

# --- Нужен только для SPORTS_PROVIDER=football-data ---
FOOTBALL_DATA_API_KEY=replace-me
